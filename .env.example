# Public metadata only. Never put private API keys here.
# SITE_URL=https://your-taskflow-domain.example
# Keep provisional deployments out of search results, even with a valid URL.
SITE_INDEXABLE=false

# Server runtime only. Cloud Run uses its attached service account (ADC).
# The deployment script injects real secrets from Google Secret Manager.
VOICE_DEMO_ENABLED=false
GOOGLE_CLOUD_PROJECT=taskflow-511107
VOICE_PUBLIC_ORIGIN=https://taskflow.garbar.tech
VOICE_MONTHLY_BUDGET_EUR=25
# TURNSTILE_SITE_KEY=public-widget-key
# VOICE_APP_SECRET=provided-by-secret-manager
# VOICE_EDGE_SECRET=provided-by-secret-manager-and-matching-worker-secret
# TURNSTILE_SECRET_KEY=provided-by-secret-manager
