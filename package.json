{
  "name": "taskflow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "check": "next typegen && tsc --noEmit",
    "legal:check": "node scripts/dev/check-legal.mjs",
    "test": "playwright test",
    "test:unit": "tsx --test tests/voice.unit.ts",
    "test:quota": "tsx --test tests/voice-store.integration.ts",
    "format": "prettier --write src tests *.ts *.json *.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google/genai": "^2.28.0",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "wrangler": "^4.149.0"
  }
}
